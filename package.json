{
	"name": "@pj-hoakari/web-crowd-detection-utils",
	"version": "0.0.0",
	"description": "Reusable building blocks for browser-based crowd / person detection.",
	"type": "module",
	"sideEffects": false,
	"license": "ISC",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pj-hoakari/web-crowd-detection-utils.git"
	},
	"homepage": "https://github.com/pj-hoakari/web-crowd-detection-utils#readme",
	"bugs": {
		"url": "https://github.com/pj-hoakari/web-crowd-detection-utils/issues"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"skills",
		"!skills/_artifacts"
	],
	"bin": {
		"wcdu-copy-runtime-assets": "./dist/bin/copy-runtime-assets.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./background": {
			"types": "./dist/background/index.d.ts",
			"import": "./dist/background/index.js"
		},
		"./bytetrack": {
			"types": "./dist/bytetrack/index.d.ts",
			"import": "./dist/bytetrack/index.js"
		},
		"./line-crossing": {
			"types": "./dist/line-crossing/index.d.ts",
			"import": "./dist/line-crossing/index.js"
		},
		"./onnx": {
			"types": "./dist/onnx/index.d.ts",
			"import": "./dist/onnx/index.js"
		},
		"./source": {
			"types": "./dist/source/index.d.ts",
			"import": "./dist/source/index.js"
		},
		"./yolo": {
			"types": "./dist/yolo/index.d.ts",
			"import": "./dist/yolo/index.js"
		}
	},
	"dependencies": {
		"onnxruntime-web": "^1.24.3"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"check": "biome check",
		"check:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@tanstack/intent": "0.3.6",
		"@vitest/coverage-v8": "4.1.11",
		"happy-dom": "20.11.6",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"keywords": [
		"tanstack-intent"
	]
}
